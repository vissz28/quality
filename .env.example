# Copy to .env and fill in. docker-compose loads this file (env_file: .env).
# Required values have no default and the app won't start without them.

# ── Anthropic (agents) ───────────────────────────────────────────────────────
# Used by the Software Engineer, Code Guardian, and Test Calibrator agents.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitLab (required) ─────────────────────────────────────────────────────────
# Base URL of your GitLab instance (no /api suffix) and a token with api scope.
GITLAB_URL=https://gitlab.mycompany.com
GITLAB_TOKEN=glpat-...
# Optional shared secret; when set, incoming webhooks must send the matching
# X-Gitlab-Token header (see app/middleware.py).
GITLAB_WEBHOOK_SECRET=
# Name of the external commit status the bot posts on each MR.
STATUS_NAME=quality-gate

# ── SonarQube / SonarCloud (required) ─────────────────────────────────────────
# The bot READS the quality gate from here (it never runs the scan — the reviewed
# project's own CI does that). Point it at SonarCloud or your own server:
#   SonarCloud:  SONARQUBE_URL=https://sonarcloud.io
#   Self-hosted: SONARQUBE_URL=https://sonarqube.mycompany.com
#     (or run the bundled one: `docker compose --profile self-sonar up`)
SONARQUBE_URL=https://sonarcloud.io
# Token — SonarCloud or SonarQube: My Account -> Security -> generate a token.
SONARQUBE_TOKEN=
# Project key exactly as it appears in Sonar. On SonarCloud keys are org-prefixed
# (e.g. my-org_my-repo), so set it explicitly. Self-hosted: defaults to the GitLab
# path (group/repo) when left unset.
SONARQUBE_PROJECT_KEY=

# ── Jira (required — Scope Analyzer reads the linked story) ───────────────────
# The project's GitLab↔Jira integration auto-links the MR to its Jira story via
# the ticket key (in the branch / title). The bot reads that key and fetches the
# story here to check the change against the story's functional requirements.
# Jira Cloud REST v3, basic auth (email + API token from id.atlassian.com).
JIRA_URL=https://mycompany.atlassian.net
JIRA_EMAIL=you@mycompany.com
JIRA_API_TOKEN=
# Optional: when set, a ticket key from this project wins during key extraction.
# JIRA_PROJECT_KEY=

# The advisory agents (Scope Analyzer, Docs Reviewer, Risk Analyzer) are
# read-only: they report and flag, they never write to the repo.

# ── Runner / execution (set by docker-compose; override only if needed) ───────
# RUNNER_URL=http://runner:3000
# PLAYWRIGHT_WORKDIR=
