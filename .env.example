# Copy to .env and fill in. docker-compose loads this file (env_file: .env).
# Required values have no default and the app won't start without them.

# ── Anthropic (agents) ───────────────────────────────────────────────────────
# Used by the Software Engineer, Code Guardian, and Test Calibrator agents.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitLab (required) ─────────────────────────────────────────────────────────
# Base URL of your GitLab instance (no /api suffix) and a token with api scope.
GITLAB_URL=https://gitlab.mycompany.com
GITLAB_TOKEN=glpat-...
# Optional shared secret; when set, incoming webhooks must send the matching
# X-Gitlab-Token header (see app/middleware.py).
GITLAB_WEBHOOK_SECRET=
# Name of the external commit status the bot posts on each MR.
STATUS_NAME=quality-code

# ── SonarQube ─────────────────────────────────────────────────────────────────
# Base URL of the SonarQube server (scheme + host [+ port], no path).
#   Local docker-compose (default): leave unset — compose points the app at the
#     bundled server via http://sonarqube:9000.
#   Deploy / hosted server: set this to the real address; it overrides the
#     compose default. The deployed app must be able to route to it (network,
#     VPN, firewall) — do NOT use localhost / host.docker.internal on a server.
# SONARQUBE_URL=https://sonarqube.mycompany.com
# Analysis token (My Account -> Security in the SonarQube UI).
SONARQUBE_TOKEN=
# Optional. Defaults to the GitLab project path (group/repo) so one deployment
# serves many projects. Set explicitly only for a single-project setup.
SONARQUBE_PROJECT_KEY=

# ── Jira (optional — enables the Trace Warden scope check) ────────────────────
# When unset, the Scope & Traceability check degrades to "not evaluated" and
# never blocks. Jira Cloud REST v3 with basic auth (email + API token).
# JIRA_URL=https://mycompany.atlassian.net
# JIRA_EMAIL=you@mycompany.com
# JIRA_API_TOKEN=
# Optional: when set, a ticket key from this project wins during key extraction.
# JIRA_PROJECT_KEY=

# ── Opt-in repo actions (off by default; both WRITE to the repo) ──────────────
# Risk Marshal: on a passing gate, tag the target branch as a rollback anchor.
# ROLLBACK_AUTOTAG=false
# Change Herald: append the suggested entry to CHANGELOG.md on the source branch
# (commit carries [skip ci] so it doesn't retrigger the pipeline).
# CHANGELOG_AUTOUPDATE=false

# ── Runner / execution (set by docker-compose; override only if needed) ───────
# RUNNER_URL=http://runner:3000
# PLAYWRIGHT_WORKDIR=
