# Copy to .env and fill in. docker-compose loads this file (env_file: .env).
# Required values have no default and the app won't start without them.

# ── Anthropic (agents) ───────────────────────────────────────────────────────
# Used by the Software Engineer and Test Calibrator agents.
ANTHROPIC_API_KEY=sk-ant-...

# ── GitLab (required) ─────────────────────────────────────────────────────────
# Base URL of your GitLab instance (no /api suffix) and a token with api scope.
GITLAB_URL=https://gitlab.mycompany.com
GITLAB_TOKEN=glpat-...
# Optional shared secret; when set, incoming webhooks must send the matching
# X-Gitlab-Token header (see app/middleware.py).
GITLAB_WEBHOOK_SECRET=
# Name of the external commit status the bot posts on each MR.
STATUS_NAME=quality-gate

# ── SonarQube / SonarCloud (required) ─────────────────────────────────────────
# The bot READS the quality gate from here. Point it at SonarCloud or your server:
#   SonarCloud:  SONARQUBE_URL=https://sonarcloud.io
#   Self-hosted: SONARQUBE_URL=https://sonarqube.mycompany.com
#     (or run the bundled one: `docker compose --profile self-sonar up`)
SONARQUBE_URL=https://sonarcloud.io
# Token — SonarCloud or SonarQube: My Account -> Security -> generate a token.
SONARQUBE_TOKEN=
# SonarCloud organization key (e.g. vissz28). When set, the project key follows
# the repo being scanned: <org>_<repo> (vissz28 + quality -> vissz28_quality), so
# one deployment can review many repos, each into its own SonarCloud project.
SONAR_ORG=
# Explicit key override — only for a SINGLE-repo deployment. Leave BLANK to derive
# <org>_<repo> per repo (above). Self-hosted SonarQube (no org prefix): falls back
# to the GitLab path (group/repo) when both this and SONAR_ORG are unset.
SONARQUBE_PROJECT_KEY=

# ── SonarCloud scan (in-bot, default) ────────────────────────────────────────
# The bot scans each MR ITSELF: the Docker image ships the sonar-scanner CLI, so
# the bot clones the reviewed repo, scans it (PR scope), uploads to SonarCloud,
# then reads the result above. No separate GitLab project, no editing the reviewed
# repo. Active automatically when the scanner + git + SONARQUBE_TOKEN + SONAR_ORG
# are present (they are, in the image). Cloning uses GITLAB_TOKEN (read).

# ── SonarCloud scan (external pipeline — optional fallback) ───────────────────
# Only used if the in-bot scanner is unavailable. Points at a standalone GitLab
# scanner project (examples/external-sonar-scan.gitlab-ci.yml) that the bot
# triggers per MR. Leave unset to rely on the in-bot scanner.
SONAR_SCAN_PROJECT_ID=
SONAR_SCAN_TRIGGER_TOKEN=
SONAR_SCAN_REF=main
SONAR_SCAN_TIMEOUT=300
# In-bot scanning is OPT-IN and OFF by default: the sonar-scanner JVM is memory
# heavy and can OOM-kill the whole service on a small instance. Enable ONLY on an
# instance with enough spare RAM for the heap below plus the bot itself.
SONAR_INBOT_SCAN=false
# Heap for the scanner JVM. Keep it BELOW the instance's free RAM — if it exceeds
# the container limit the OS kills the service (a smaller heap only fails the scan).
SONAR_SCANNER_JAVA_OPTS=-Xmx2048m
# SONAR_EXCLUSIONS=**/node_modules/**,**/dist/**,**/build/**,**/*.min.js
# Ephemeral mode: create → scan → read → DELETE the SonarCloud project each MR.
# Valid because "new code" is the MR diff (no baseline needed). Requires the token
# to have project-admin (delete) permission. Off by default (project persists).
SONAR_SCAN_EPHEMERAL=false

# ── Jira (required — Scope Analyzer reads the linked story) ───────────────────
# The project's GitLab↔Jira integration auto-links the MR to its Jira story via
# the ticket key (in the branch / title). The bot reads that key and fetches the
# story here to check the change against the story's functional requirements.
# Jira Cloud REST v3, basic auth (email + API token from id.atlassian.com).
JIRA_URL=https://mycompany.atlassian.net
JIRA_EMAIL=you@mycompany.com
JIRA_API_TOKEN=
# Optional: when set, a ticket key from this project wins during key extraction.
# JIRA_PROJECT_KEY=

# The advisory agents (Scope Analyzer, Docs Reviewer, Risk Analyzer) are
# read-only: they report and flag, they never write to the repo.

# ── Runner / execution (set by docker-compose; override only if needed) ───────
# RUNNER_URL=http://runner:3000
# PLAYWRIGHT_WORKDIR=
